[base]
name=CentOS-7.9.2009 - Base (JAIST Vault)
baseurl=https://ftp.jaist.ac.jp/pub/Linux/CentOS-vault/7.9.2009/os/$basearch/
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7
enabled=1

[updates]
name=CentOS-7.9.2009 - Updates (JAIST Vault)
baseurl=https://ftp.jaist.ac.jp/pub/Linux/CentOS-vault/7.9.2009/updates/$basearch/
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7
enabled=1

[extras]
name=CentOS-7.9.2009 - Extras (JAIST Vault)
baseurl=https://ftp.jaist.ac.jp/pub/Linux/CentOS-vault/7.9.2009/extras/$basearch/
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7
enabled=1

[centosplus]
name=CentOS-7.9.2009 - Plus (JAIST Vault)
baseurl=https://ftp.jaist.ac.jp/pub/Linux/CentOS-vault/7.9.2009/centosplus/$basearch/
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7
enabled=0